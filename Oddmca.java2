//WAP to display table of a passed number and display all odd number from 1 to 100 .Execute both tasks simulataneously using multithreading
class TableThread extends Thread {
    int num;

    TableThread(int num) {
        this.num = num;
    }

    public void run() {
        System.out.println("Table of " + num + ":");
        for (int i = 1; i <= 10; i++) {
            System.out.println(num + " x " + i + " = " + (num * i));
            try {
                Thread.sleep(500); // delay for better visualization
            } catch (InterruptedException e) {
                System.out.println(e);
            }
        }
    }
class OddThread extends Thread {
    public void run() {
        System.out.println("\nOdd numbers from 1 to 100:");
        for (int i = 1; i <= 100; i += 2) {
            System.out.print(i + " ");
            try {
                Thread.sleep(300); // delay for better visualization
            } catch (InterruptedException e) {
                System.out.println(e);
            }
        }
    }
}

// Main class
public class MultiTask {
    public static void main(String[] args) {
        int number = 5; // you can change this value

        TableThread t1 = new TableThread(number);
        OddThread t2 = new OddThread();

        // Start both threads simultaneously
        t1.start();
        t2.start();
    }
}